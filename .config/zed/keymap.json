// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // vim bindings
  {
    "context": "VimControl && !menu",
    "bindings": {
      "h": "vim::WrappingLeft",
      "l": "vim::WrappingRight",
      "shift-h": "vim::FirstNonWhitespace",
      "shift-l": "vim::EndOfLine",
      "x": ["workspace::SendKeystrokes", "\"+"],
    },
  },

  // normal mode bindings
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space r": "editor::Rename",
      "space f": "editor::Format",
      "g f": "file_finder::Toggle",
      "tab": "vim::GoToTab",
      "shift-tab": "vim::GoToPreviousTab",
      "s a": "vim::PushAddSurrounds",
      "s c": "vim::PushChangeSurrounds",
      "s r": "vim::PushChangeSurrounds",
      "s d": "vim::PushDeleteSurrounds",
    },
  },

  // visual mode bindings
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "shift-x": "vim::Exchange",
      "s": "vim::PushAddSurrounds",
    },
  },

  // quote and bracket text objects
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
    },
  },

  // make ctrl-j and ctrl-k move up/down completion menus and pickers
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },

  // project panel
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "s": "project_panel::OpenSplitHorizontal",
    },
  },

  // UNBINDS
  {
    "context": "vim_mode == normal",
    "unbind": {
      "x": "vim::DeleteRight",
      "s": "vim::Substitute",
    },
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "x": "vim::VisualDelete",
      "s": "vim::Substitute",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-j": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-j": "vim::Down",
    },
  },
  {
    "context": "vim_operator == d",
    "unbind": {
      "s": "vim::PushDeleteSurrounds",
    },
  },
  {
    "context": "vim_operator == c",
    "unbind": {
      "s": ["vim::PushChangeSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == y",
    "unbind": {
      "s": ["vim::PushAddSurrounds", {}],
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "shift-r": "project_panel::Rename",
      "shift-d": "project_panel::Delete",
      "%": "project_panel::NewFile",
      "d": "project_panel::NewDirectory",
      "o": "project_panel::OpenSplitHorizontal",
    },
  },
]
